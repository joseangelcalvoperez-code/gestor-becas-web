# Base de datos MySQL o MariaDB
DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/gestor_becas_web_firmas"
SHADOW_DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/gestor_becas_web_firmas_shadow"

# Sesiones: genere un valor largo y aleatorio para cada entorno
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# URL pública, sin barra final
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Correo mediante Resend
EMAIL_PROVIDER="resend"
EMAIL_FROM="Gestor de Becas <no-reply@example.com>"
RESEND_API_KEY=""

# Opcional: dirección utilizada para pruebas de envío
EMAIL_DEMO_TO=""
