# ============================================
# GESTOR DE BECAS WEB
# Variables de entorno de ejemplo
# ============================================

# --------------------------------------------
# PRISMA / MIGRACIONES
# --------------------------------------------

DATABASE_URL="mysql://USUARIO:CONTRASENA@127.0.0.1:3306/NOMBRE_BASE_DATOS"

SHADOW_DATABASE_URL="mysql://USUARIO:CONTRASENA@127.0.0.1:3306/NOMBRE_BASE_DATOS_SHADOW"


# --------------------------------------------
# CONEXIÓN DE LA APLICACIÓN A MYSQL
# --------------------------------------------

DATABASE_HOST="127.0.0.1"

DATABASE_PORT="3306"

DATABASE_USER="USUARIO"

DATABASE_PASSWORD="CONTRASENA"

DATABASE_NAME="NOMBRE_BASE_DATOS"


# --------------------------------------------
# SEGURIDAD / SESIONES
# --------------------------------------------

AUTH_SECRET="SUSTITUIR_POR_UNA_CLAVE_SECRETA_SEGURA"

# --------------------------------------------
# RENDIMIENTO (opcionales; valores por defecto entre paréntesis)
# --------------------------------------------

# Conexiones MySQL por proceso Node (20).
# Regla: DATABASE_POOL_SIZE x nº de procesos < max_connections de MySQL.
DATABASE_POOL_SIZE="20"

# MySQL 8 sin SSL necesita permitir la obtención de clave pública para
# autenticar (caching_sha2_password). Por defecto: activado si la base de
# datos es local (127.0.0.1/localhost), desactivado si es remota.
# DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL="1"

# Conexión cifrada con MySQL (recomendada en servidor). Si "npm run probar:bd"
# indica que solo conecta con SSL, activar aquí.
# DATABASE_SSL="1"
# Validar el certificado del servidor (requiere certificado de confianza):
# DATABASE_SSL_VERIFY="1"

# Espera máxima por una conexión libre del pool, en ms (15000).
DATABASE_ACQUIRE_TIMEOUT_MS="15000"

# Documentos PDF generados a la vez por proceso (nº de CPU, mínimo 2).
PDF_CONCURRENCIA="4"

# Expedientes de alumnos generados en paralelo en la generación masiva (3).
EXPEDIENTES_CONCURRENCIA="3"


# --------------------------------------------
# IDENTIDAD INSTITUCIONAL (opcional; ver src/lib/marca.ts)
# --------------------------------------------

NEXT_PUBLIC_ORGANISMO="Comunidad de Madrid"

NEXT_PUBLIC_CONSEJERIA="Consejería de Educación, Universidades, Ciencia y Portavocía"

# El logotipo (public/marca/) se muestra siempre; "1" lo oculta y usa un símbolo neutro.
# NEXT_PUBLIC_OCULTAR_LOGOTIPO="1"

# Contacto del servicio de soporte que se muestra en «¿Ha olvidado su contraseña?»
# (opcional), por ejemplo: "CAU Educación · 91 000 00 00"
# NEXT_PUBLIC_SOPORTE_CONTACTO=""
